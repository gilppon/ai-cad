# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- SP1 보안 플래그 (code_remediation_plan_v1.0_20260826.md) ---
# SUPABASE_JWT_SECRET: Supabase JWT 검증 시크릿. 운영(ENV=production)에서는 미설정 시 기동 거부.
SUPABASE_JWT_SECRET="your-jwt-secret"
# ALLOW_AUTH_BYPASS: 로컬 개발 전용 인증 우회. 1로 명시 설정+비운영 환경에서만 동작. 기본 비활성.
ALLOW_AUTH_BYPASS=""
# PAYMENT_ALLOW_MOCK_WEBHOOK: 서명 없는 Stripe 웹훅 Mock 수신 허용(로컬/테스트 전용). 기본 비활성.
PAYMENT_ALLOW_MOCK_WEBHOOK=""
# JP_INVOICE_REGISTRATION_NUMBER: 적격청구서발행사업자 등록번호(T+13자리). 미설정 시 문서에 (未登録) 표기.
JP_INVOICE_REGISTRATION_NUMBER=""
# ALLOWED_ORIGINS: CORS 허용 오리진(콤마 구분). 미설정 시 ENV별 기본값 사용. (SP4/H-3)
ALLOWED_ORIGINS=""
